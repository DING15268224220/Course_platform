{
  "name": "course-project-review-platform",
  "version": "4.0.0",
  "private": true,
  "description": "高校课程项目协作与评审平台桌面版",
  "main": "main.cjs",
  "scripts": {
    "desktop": "electron .",
    "desktop:debug": "set ELECTRON_ENABLE_LOGGING=1&& electron .",
    "test:backend": "python -m pytest ..\\backend\\tests -q",
    "build:backend": "python scripts\\build_backend.py",
    "dist:win": "npm run build:backend && electron-builder --win portable"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "cn.edu.course.projectreview",
    "productName": "高校课程项目协作与评审平台",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist-backend/course-platform-backend.exe",
        "to": "backend/course-platform-backend.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CourseProjectReviewPlatform-${version}-portable.${ext}"
    }
  }
}
